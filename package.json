{
  "name": "4q-tokenz",
  "mcpName": "io.github.steveweltman/4q-tokenz",
  "version": "1.22.3",
  "description": "MCP Proxy Gateway - Intelligent proxy that reduces token usage by exposing only mcp_search, mcp_call, and mcp_schema",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-proxy": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "install.sh",
    "server.json",
    "tsconfig.json",
    "config.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "test:cov": "echo 'No tests configured'",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.13.5",
      "@hono/node-server": ">=1.19.15",
      "fast-uri": ">=4.1.4",
      "ip-address": ">=10.5.1",
      "body-parser": ">=2.3.0",
      "qs": ">=6.16.0"
    }
  },
  "keywords": [
    "mcp",
    "proxy",
    "gateway",
    "token-reduction",
    "llm",
    "ai",
    "claude",
    "context-window"
  ],
  "author": "Steve Weltman (fork of @arvoretech/mcp-proxy by Árvore Educação)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveweltman/4q-tokenz.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
